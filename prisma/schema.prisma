generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VoucherStatus {
  STOCK
  RESERVED
  SOLD
  ACTIVATED
  EXPIRED
  DISABLED
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLING
  FULFILLED
  EXPIRED
  CANCELLED
  PAYMENT_FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum PaymentMethod {
  QRIS
  MANUAL
  OTHER
}

model Package {
  id              String    @id @default(uuid()) @db.Uuid
  code            String    @unique @db.VarChar(20)
  name            String    @db.VarChar(100)
  durationMinutes Int
  speedMbps       Int
  price           Int
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vouchers         Voucher[]
  orders           Order[]

  @@index([isActive])
  @@map("packages")
}

model Voucher {
  id                String        @id @default(uuid()) @db.Uuid
  packageId         String        @db.Uuid
  code              String        @unique @db.VarChar(64)
  username          String        @unique @db.VarChar(64)
  password          String        @db.VarChar(128)
  status            VoucherStatus @default(STOCK)
  mikrotikUsername  String?       @db.VarChar(64)
  mikrotikDeviceId  String?       @db.Uuid
  reservedUntil     DateTime?
  soldAt            DateTime?
  activatedAt       DateTime?
  expiresAt         DateTime?
  expiredAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  package           Package       @relation(fields: [packageId], references: [id])
  mikrotikDevice    MikrotikDevice? @relation(fields: [mikrotikDeviceId], references: [id])
  order             Order?

  @@index([packageId, status])
  @@index([status, reservedUntil])
  @@index([mikrotikDeviceId])
  @@map("vouchers")
}

model Order {
  id                   String      @id @default(uuid()) @db.Uuid
  orderNumber          String      @unique @db.VarChar(40)
  packageId            String      @db.Uuid
  voucherId            String?     @unique @db.Uuid
  customerIdentifier   String?     @db.VarChar(120)
  amount               Int
  status               OrderStatus @default(PENDING)
  expiresAt             DateTime?
  paidAt                DateTime?
  fulfilledAt           DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  package              Package     @relation(fields: [packageId], references: [id])
  voucher              Voucher?    @relation(fields: [voucherId], references: [id])
  payments             Payment[]

  @@index([status, createdAt])
  @@index([packageId, status])
  @@map("orders")
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  orderId               String        @db.Uuid
  provider              String        @db.VarChar(40)
  providerTransactionId String?       @unique @db.VarChar(160)
  method                PaymentMethod
  amount                Int
  status                PaymentStatus @default(PENDING)
  rawResponse           Json?
  createdAt             DateTime      @default(now())
  paidAt                DateTime?

  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
  @@index([provider, status])
  @@map("payments")
}

model MikrotikDevice {
  id             String    @id @default(uuid()) @db.Uuid
  name           String    @unique @db.VarChar(100)
  host           String    @db.VarChar(255)
  apiPort        Int       @default(8728)
  username       String    @db.VarChar(100)
  passwordSecret String    @db.VarChar(255)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  vouchers       Voucher[]

  @@map("mikrotik_devices")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  action      String   @db.VarChar(80)
  entityType  String   @db.VarChar(80)
  entityId    String?  @db.VarChar(100)
  description String   @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}
